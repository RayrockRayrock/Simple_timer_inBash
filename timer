#!/usr/bin/env bash




program_path="where you want to put this script"
#ex: program_path="$HOME/.local/bin/timer"



start_audio_path="path to your start audio"
#ex: start_audio_path="$HOME/Pictures/meme/startup.mp3"



timeout_audio_path="path to your timeout audio"
#ex: timeout_audio_path="$HOME/Pictures/meme/timeoutdeformation.mp3"




if [[ $1 == "set" ]];
then
  $EDITOR $program_path
  exit
fi
#type 「timer set」 to open this script with your editor
#don't forget to set the program_path


notify-send "Startup!!!" && paplay $start_audio_path && sleep $1 && notify-send "Timeout!!!!" && paplay $timeout_audio_path


